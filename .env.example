# =============================================================
# ReadRace - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste se necessário.
# Os valores abaixo já funcionam para desenvolvimento local.
# =============================================================

# ---- Banco de Dados ----
DB_NAME=readrace
DB_USER=readrace
DB_PASSWORD=readrace
DB_PORT=5433

# ---- Backend API ----
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- CORS ----
# Vazio = nenhuma origem liberada (padrão seguro).
# O profile dev já libera "*"; esta variável serve para homologação/produção,
# onde as origens reais precisam ser listadas separadas por vírgula.
# CORS_ALLOWED_ORIGINS=https://app.readrace.com,https://admin.readrace.com

# ---- Google Books API (futuro) ----
# GOOGLE_BOOKS_API_KEY=

# ---- Autenticação ----
# cognito (padrão, sem configurar nada) = exige o token do Cognito, do user pool do projeto
# (us-east-2). Para conferir: sem token, a API responde 401. Precisa de internet ao subir.
# seed = sem login: a API ignora o token e trata todos como o usuário do seed. Para rodar sem
# internet, descomente a linha abaixo, reinicie a API e deixe as variáveis do Cognito vazias no
# mobile/.env. Vale para o docker compose e para o ./mvnw spring-boot:run (o perfil dev lê este
# .env). Variável exportada no terminal tem prioridade sobre o arquivo.
# AUTH_MODO=seed
