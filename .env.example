# ---- Banco de Dados ----
DB_NAME=readrace
DB_USER=readrace
DB_PASSWORD=readrace
DB_PORT=5433

# ---- Backend API ----
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev

