# =============================================================
# ReadRace - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste se necessário.
# Os valores abaixo já funcionam para desenvolvimento local.
# =============================================================

# ---- Banco de Dados ----
DB_NAME=readrace
DB_USER=readrace
DB_PASSWORD=readrace
DB_PORT=5433

# ---- Backend API ----
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- CORS ----
# Vazio = nenhuma origem liberada (padrão seguro).
# O profile dev já libera "*"; esta variável serve para homologação/produção,
# onde as origens reais precisam ser listadas separadas por vírgula.
# CORS_ALLOWED_ORIGINS=https://app.readrace.com,https://admin.readrace.com

# ---- Google Books API (futuro) ----
# GOOGLE_BOOKS_API_KEY=

# ---- Autenticação ----
# seed = sem login (padrão em dev). cognito = exige token do Cognito.
# AUTH_MODO=seed
# COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=https://readrace.auth.us-east-1.amazoncognito.com
