# =============================================================
# ReadRace - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste se necessário.
# Os valores abaixo já funcionam para desenvolvimento local.
# =============================================================

# ---- Banco de Dados ----
DB_NAME=readrace
DB_USER=readrace
DB_PASSWORD=readrace
DB_PORT=5433

# ---- Backend API ----
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- CORS ----
# Vazio = nenhuma origem liberada (padrão seguro).
# O profile dev já libera "*"; esta variável serve para homologação/produção,
# onde as origens reais precisam ser listadas separadas por vírgula.
# CORS_ALLOWED_ORIGINS=https://app.readrace.com,https://admin.readrace.com

# ---- Google Books API (futuro) ----
# GOOGLE_BOOKS_API_KEY=

# ---- Autenticação ----
# seed = sem login (padrão em dev): a API ignora o token e trata todos como o usuário do seed.
# cognito = exige token do Cognito. Os valores abaixo são os do user pool do projeto (us-east-2,
# Ohio) e são públicos. Rodando a API fora do Docker, exporte cada um no terminal antes do
# ./mvnw spring-boot:run. Para conferir: sem token, a API deve responder 401.
# AUTH_MODO=cognito
# COGNITO_ISSUER_URI=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_MEVIpejhy
# COGNITO_CLIENT_ID=5f06kagodbku0mvveakmsim8qu
# COGNITO_DOMAIN=https://us-east-2mevipejhy.auth.us-east-2.amazoncognito.com
