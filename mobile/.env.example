# Copie para mobile/.env. O Expo lê o arquivo ao rodar `npx expo start` (reinicie ao mudar).

# URL do backend. Sem ela, o app usa http://localhost:8080.
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Login com Cognito. Vazio = login desligado (combina com o backend em AUTH_MODO=seed).
# Valores no console do Cognito: Branding > Domain e Applications > App clients > Client ID.
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
